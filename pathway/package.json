{
  "name": "concordia-soccer-pathway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:images && next dev --port 3100",
    "build": "npm run check:content && npm run build:images && next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "check:content": "node --experimental-strip-types scripts/check-content.mts && npm run -s test:status && npm run -s test:tax",
    "build:logo": "node scripts/build-logo.mjs",
    "build:map": "node scripts/build-map.mjs",
    "build:images": "node scripts/build-images.mjs",
    "test:status": "node --no-warnings --experimental-strip-types scripts/test-assessment-status.mts",
    "test:tax": "node --no-warnings --experimental-strip-types scripts/test-tax.mts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@netlify/blobs": "^11.1.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
